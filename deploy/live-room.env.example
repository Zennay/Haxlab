# Copy to /etc/haxlab/live-room.env; do not commit real tokens.
HAXBALL_HEADLESS_TOKEN_FILE=/etc/haxlab/headless-token
HAXLAB_LIVE_ROOM_NAME=HaxLab Live Champion Test
HAXLAB_LIVE_PUBLIC=0
HAXLAB_LIVE_BOT_TEAM=red
HAXLAB_LIVE_SCORE_LIMIT=3
HAXLAB_LIVE_TIME_LIMIT=5
HAXLAB_LIVE_AUTO_START=1

# Optional: point this at the validated custom stadium for fidelity testing.
# Without it, the launcher uses default Big and prints a warning.
# HAXLAB_LIVE_STADIUM=/var/lib/haxlab/derived/live/bff-big-v4.hbs
